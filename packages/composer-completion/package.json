{
  "name": "@kermanx/dsh-composer-completion",
  "description": "Independent Host and Web composer ghost-text completion plugin for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -b ../../tsconfig.host.json && node scripts/generate-typert.mjs && tsdown --config tsdown.host.config.ts",
    "build:client": "tsc -b ../../tsconfig.client.json && tsdown --config tsdown.client.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "0.1.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-api-gateway": { "optional": true },
    "@deepseek-ai/dsh-api-session-controller": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-session": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness-4/vendor/cordis",
    "@deepseek-ai/dsh-api-gateway": "link:../../../deepseek-harness-4/packages/api/gateway",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../deepseek-harness-4/packages/api/session-controller",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../deepseek-harness-4/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../deepseek-harness-4/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../../../deepseek-harness-4/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness-4/packages/client/ui-slots",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness-4/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness-4/packages/core/session",
    "@deepseek-ai/dsh-typert-generator": "link:../../../deepseek-harness-4/packages/typert/generator",
    "@deepseek-ai/dsh-typert-protocol": "link:../../../deepseek-harness-4/packages/typert/protocol",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness-4/vendor/schemastery",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  }
}
